' ============ CLÉOPÂTRE — Séquence, authentification ============
' loginAction → vérification des identifiants → session (cookie httpOnly)

actor "Utilisateur" as User
participant "Interface\n(Next.js)" as UI
participant "Server Actions" as SA
participant "lib/auth" as Auth
participant "PostgreSQL" as DB

User -> UI : Renseigne email + mot de passe
User -> UI : Soumet le formulaire
UI -> SA : loginAction
SA -> SA : Valide les données (Zod)
SA -> Auth : Vérifie les identifiants
Auth -> DB : Recherche le compte
DB --> Auth : Compte (hash du mot de passe)

alt Identifiants invalides
  Auth --> SA : Vérification échouée
  SA --> UI : Échec de l'authentification
  UI --> User : Message d'erreur
else Identifiants valides
  Auth --> SA : Identifiants valides
  SA -> Auth : createSession
  Auth -> DB : Enregistre la session
  DB --> Auth : Session enregistrée
  Auth --> SA : Session établie (cookie httpOnly, 30 jours)
  SA --> UI : Redirection (compte ou back-office)
  UI --> User : Espace connecté
end
