@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Inter
skinparam defaultFontSize 14
skinparam defaultFontColor #2C2A26
skinparam ActorBackgroundColor #F8F5F0
skinparam ActorBorderColor #2C2A26
skinparam ActorFontSize 13
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #2C2A26
skinparam ParticipantFontSize 13
skinparam SequenceLifeLineBorderColor #8A857C
skinparam SequenceArrowColor #2C2A26
skinparam SequenceArrowThickness 1.4
skinparam SequenceGroupBackgroundColor #FAF8F5
skinparam SequenceGroupBorderColor #C9B896
skinparam ActivationBackgroundColor #F0EBE3
skinparam ActivationBorderColor #C9B896
skinparam maxMessageSize 220
skinparam style strictuml

actor "Utilisateur" as User
participant "Page\n/boutique\n/produit/[slug]" as Page
participant "lib/catalog\nServer Component" as Catalog
participant "PostgreSQL" as DB

User -> Page : GET /boutique
Page -> Catalog : getUniverses()\n+ query produits
Catalog -> DB : SELECT products\nWHERE status = 'active'\n+ joins
DB --> Catalog
Catalog --> Page
Page --> User : Listing

== Fiche produit ==
User -> Page : GET /produit/{slug}
Page -> Catalog : findBySlug(slug)
Catalog -> DB : SELECT product\n+ brand + concerns\nWHERE slug = ?\nAND status = 'active'
DB --> Catalog : product | null
alt Trouvé
  Catalog --> Page
  Page --> User : Fiche produit
else Introuvable
  Page --> User : 404
end

@enduml
