@startuml
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Inter
skinparam defaultFontSize 13
skinparam defaultFontColor #2C2A26
skinparam ArrowColor #55504A
skinparam ArrowThickness 1.1
skinparam RoundCorner 8
skinparam classAttributeIconSize 0
hide circle
hide empty fields
hide empty methods
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #A89B85
  BorderThickness 1
  FontColor #2C2A26
  FontStyle plain
  FontSize 13
  StereotypeFontColor #8A7E69
  StereotypeFontStyle plain
  AttributeFontColor #4A443A
  AttributeFontSize 12
  AttributeFontStyle plain
  MethodFontSize 12
  MethodFontColor #4A443A
  MethodFontStyle plain
  SeparatorColor #DCCFBA
}
skinparam enum {
  BackgroundColor #FCFAF5
  BorderColor #C9BCA4
  BorderThickness 1
  FontColor #2C2A26
  FontStyle plain
  EnumFontSize 12
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #A89B85
  BorderThickness 1
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FAF7F1
  BorderColor #DCCFBA
  BorderThickness 1
  FontColor #4A443A
  FontSize 14
  FontStyle plain
}
skinparam note {
  BackgroundColor #FBF8F2
  BorderColor #DCCFBA
  FontColor #6E675C
  FontSize 11
  BorderThickness 1
}
skinparam sequence {
  ArrowColor #4A463F
  ArrowThickness 1.1
  LifeLineBorderColor #C9BDA8
  LifeLineBackgroundColor #FFFFFF
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #A89B85
  ParticipantFontColor #2C2A26
  ParticipantFontSize 13
  ParticipantFontStyle plain
  ActorBackgroundColor #F6F1E8
  ActorBorderColor #A89B85
  ActorFontColor #2C2A26
  ActorFontSize 13
  GroupBackgroundColor #FAF7F1
  GroupBorderColor #D5C7AE
  GroupFontColor #4A443A
  GroupHeaderFontSize 13
  ActivationBackgroundColor #F2EDE3
  ActivationBorderColor #C9BCA4
  DividerBackgroundColor #F1EBDF
  DividerBorderColor #D5C7AE
  DividerFontColor #4A443A
  DividerFontSize 13
  MessageFontColor #3A352E
  ResponseMessageFontColor #7A7263
  BoxPadding 14
  ParticipantPadding 22
}

' ============ CLÉOPÂTRE — Diagramme de classes, vue globale ============
' Six domaines fonctionnels : auth, services applicatifs, catalogue,
' expérience client, commandes, persistance. Classes nommées uniquement.

package "Utilisateurs & Auth" as PU {
  class User
  class Session
  class Address
}

package "Catalogue" as PC {
  class Product
  class Brand
  class Category
  class Concern
}

package "Services applicatifs" as PS {
  class CheckoutService  <<module>>
  class CartService      <<module>>
  class ShopService      <<module>>
  class AuthService      <<module>>
  class CatalogService   <<module>>
}

package "Expérience client" as PE {
  class Review
  class WishlistItem
  class Promotion
  class GiftCard
  class SupportTicket
}

package "Commandes" as PO {
  class Order
  class OrderItem
  class OrderEvent
}

package "Persistance" as PD {
  class Database <<singleton>>
  class Schema <<Drizzle>>
}

' ---------- relations structurelles ----------
User "1" -- "0..*" Session  : userId
User "1" -- "0..*" Address  : userId
User "1" -- "0..*" Order

Brand    "1" -- "0..*" Product : brandId
Category "1" -- "0..*" Product : categoryId
Product  "*" -- "*"    Concern : product_concerns
Product  "1" -- "0..*" Review  : productId
Product  "1" -- "0..*" WishlistItem : productId

Order "1" -- "1..*" OrderItem : productId
Order "1" -- "0..*" OrderEvent : orderId
' ---------- dépendances services → domaine ----------
AuthService    ..> User
CatalogService ..> Product  : lit / recherche
ShopService    ..> Review   : modère
CheckoutService ..> Order   : crée
CartService    ..> Database : requêtes

' ---------- persistance ----------
Database ..> Schema : tables

' ---------- guidage de mise en page (invisible) ----------
User -[hidden]right-> AuthService
AuthService -[hidden]right-> CatalogService
CatalogService -[hidden]right-> Product
Brand -[hidden]down-> Product
Product -[hidden]down-> Review
Review -[hidden]left-> WishlistItem
WishlistItem -[hidden]left-> Promotion
Promotion -[hidden]left-> Order
Address -[hidden]down-> Order
Order -[hidden]down-> OrderItem
OrderItem -[hidden]down-> Database
Database -[hidden]left-> Schema

@enduml
