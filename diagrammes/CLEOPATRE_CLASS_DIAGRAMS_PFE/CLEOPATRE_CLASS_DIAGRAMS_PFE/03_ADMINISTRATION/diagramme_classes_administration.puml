@startuml
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Inter
skinparam defaultFontSize 13
skinparam defaultFontColor #2C2A26
skinparam ArrowColor #55504A
skinparam ArrowThickness 1.1
skinparam RoundCorner 8
skinparam classAttributeIconSize 0
hide circle
hide empty fields
hide empty methods
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #A89B85
  BorderThickness 1
  FontColor #2C2A26
  FontStyle plain
  FontSize 13
  StereotypeFontColor #8A7E69
  StereotypeFontStyle plain
  AttributeFontColor #4A443A
  AttributeFontSize 12
  AttributeFontStyle plain
  MethodFontSize 12
  MethodFontColor #4A443A
  MethodFontStyle plain
  SeparatorColor #DCCFBA
}
skinparam enum {
  BackgroundColor #FCFAF5
  BorderColor #C9BCA4
  BorderThickness 1
  FontColor #2C2A26
  FontStyle plain
  EnumFontSize 12
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #A89B85
  BorderThickness 1
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FAF7F1
  BorderColor #DCCFBA
  BorderThickness 1
  FontColor #4A443A
  FontSize 14
  FontStyle plain
}
skinparam note {
  BackgroundColor #FBF8F2
  BorderColor #DCCFBA
  FontColor #6E675C
  FontSize 11
  BorderThickness 1
}
skinparam sequence {
  ArrowColor #4A463F
  ArrowThickness 1.1
  LifeLineBorderColor #C9BDA8
  LifeLineBackgroundColor #FFFFFF
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #A89B85
  ParticipantFontColor #2C2A26
  ParticipantFontSize 13
  ParticipantFontStyle plain
  ActorBackgroundColor #F6F1E8
  ActorBorderColor #A89B85
  ActorFontColor #2C2A26
  ActorFontSize 13
  GroupBackgroundColor #FAF7F1
  GroupBorderColor #D5C7AE
  GroupFontColor #4A443A
  GroupHeaderFontSize 13
  ActivationBackgroundColor #F2EDE3
  ActivationBorderColor #C9BCA4
  DividerBackgroundColor #F1EBDF
  DividerBorderColor #D5C7AE
  DividerFontColor #4A443A
  DividerFontSize 13
  MessageFontColor #3A352E
  ResponseMessageFontColor #7A7263
  BoxPadding 14
  ParticipantPadding 22
}

' ============ CLÉOPÂTRE — Administration (back-office) ============
' Rôles, gestion des commandes / catalogue / support par les modules admin

package "Rôles & accès" as PR {
  class User {
    id : serial
    email : varchar
    role : user_role
    notes : text
  }
  enum user_role {
    customer
    support
    admin
  }
}

package "Gestion commandes" as PC {
  class Order {
    id : serial
    number : varchar
    status : order_status
    paymentStatus : payment_status
    trackingCode : varchar
    internalNote : text
  }
  class OrderEvent {
    orderId : integer «FK»
    status : order_status
    message : varchar
    actorId : integer
  }
  class ReturnRequest {
    id : serial
    orderId : integer «FK»
    status : return_status
  }
}

package "Gestion catalogue" as PK {
  class Product {
    id : serial
    name : varchar
    status : product_status
    stock : integer
  }
  class Brand {
    id : serial
    name : varchar
  }
  class Promotion {
    code : varchar
    type : promo_type
    value : integer
    isActive : boolean
  }
  class Shelf {
    id : serial
    title : jsonb
    isActive : boolean
  }
  class Duo {
    id : serial
    name : jsonb
    isActive : boolean
  }
  class Review {
    id : serial
    productId : integer «FK»
    status : review_status
  }
}

package "Support & tâches" as PS {
  class SupportTicket {
    id : serial
    type : ticket_type
    status : ticket_status
    priority : varchar
  }
  class AdminTask {
    id : serial
    title : varchar
    status : varchar
  }
  class Automation {
    id : serial
    name : varchar
    isActive : boolean
  }
}

package "Services d'administration" as PA {
  class AdminActions <<module\nsrc/actions/admin.ts>> {
    updateOrderStatusAction(orderId, next)
    bulkOrderStatusAction(ids, next)
    setPaymentStatusAction(orderId, next)
    saveOrderNotesAction(orderId, note)
    updateReturnStatusAction(id, next)
    saveProductAction(form)
    adjustStockAction(form)
    savePromotionAction(form)
    deletePromotionAction(id)
    moderateReviewAction(id, status)
    updateUserRoleAction(userId, role)
    issueGiftCardAction(amount, expiresAt)
    cancelGiftCardAction(cardId)
  }
  class AdminOS <<module\nsrc/actions/admin-os.ts>> {
    metrics()
    insights()
    diagnostics()
    automations()
  }
  class AdminLib <<lib/admin/*>> {
    metrics
    insights
    attention
    diagnostics
  }
}

package "Données" as PD {
  class Database <<singleton>> {
    db : DrizzleORM
    pool : Pool
  }
}

' ---------- relations ----------
User -- user_role : role
Order "1" -- "0..*" OrderEvent : orderId
Order "1" -- "0..*" ReturnRequest : orderId
Brand "1" -- "0..*" Product : brandId
Product "1" -- "0..*" Review : productId

AdminActions ..> Order : statut / paiement
AdminActions ..> Product : CRUD / stock
AdminActions ..> User : rôle / notes
AdminOS ..> AdminLib : utilise
AdminLib ..> Database
AdminActions ..> Database

note bottom of User
  Seuls les rôles support et admin
  accèdent au back-office
  (getCurrentUser → rôle)
end note

' ---------- guidage de mise en page ----------
' grille : Services (haut) / 3 domaines (milieu) / Rôles (droite) / Données (bas)
AdminActions -[hidden]right-> AdminOS
AdminOS -[hidden]right-> AdminLib
Order -[hidden]right-> Product
Product -[hidden]right-> SupportTicket
SupportTicket -[hidden]right-> User
User -[hidden]down-> OrderEvent
Order -[hidden]up-> AdminActions
AdminLib -[hidden]down-> Database

@enduml