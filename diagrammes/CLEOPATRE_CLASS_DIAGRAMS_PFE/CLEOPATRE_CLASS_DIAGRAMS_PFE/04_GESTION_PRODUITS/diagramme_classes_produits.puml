  ParticipantPadding 22
}

' ============ CLÉOPÂTRE — Gestion des produits (catalogue) ============
' Entités du catalogue + merchandising + modules produits

package "Catalogue — entités principales" as PC {
  class Product {
    id : serial «PK»
    slug : varchar(160) «unique»
    sku : varchar(40) «unique»
    name : varchar(200)
    shortDescription : varchar(300)
    description : text
    ingredients : text
    howToUse : text
    brandId : integer «FK»
    categoryId : integer «FK»
    universeId : integer «FK»
    priceMillimes : integer
    compareAtMillimes : integer
    stock : integer = 0
    lowStockThreshold : integer = 5
    status : product_status = active
    isFeatured : boolean
    isNew : boolean
    isCounterPick : boolean
    tolerances : jsonb
    locationStock : jsonb
    volume / texture / forWhom : varchar
    createdAt / updatedAt : timestamp
  }
  class Brand {
    id : serial «PK»
    slug : varchar(120) «unique»
    name : varchar(120)
    country : varchar(60)
    story : text
    isFeatured : boolean
  }
  class Category {
    id : serial «PK»
    slug : varchar(120) «unique»
    name : varchar(120)
    description : text
    isUniverse : boolean = false
    parentId : integer
    sortOrder : integer = 0
  }
  class Concern {
    id : serial «PK»
    slug : varchar(120) «unique»
    name : varchar(120)
    intro : text
  }
  class ProductConcern {
    productId : integer «PK, FK»
    concernId : integer «PK, FK»
  }
  enum product_status {
    draft
    active
    archived
  }
}

package "Merchandising & associations" as PM {
  class Shelf {
    id : serial «PK»
    title : jsonb (LText)
    subtitle : jsonb (LText)
    startMonth / endMonth : integer
    productIds : jsonb (number[])
    isActive : boolean
  }
  class Duo {
    id : serial «PK»
    slug : varchar(140)
    name : jsonb (LText)
    productIdA : integer «FK»
    productIdB : integer «FK»
    discountMillimes : integer
    isActive : boolean
  }
  class ProductSubstitute {
    productId : integer «FK»
    substituteProductId : integer «FK»
    position : integer
    reason : jsonb (LText)
  }
  class ProductPair {
    productId : integer «FK»
    pairProductId : integer «FK»
    position : integer
    reason : varchar(200)
  }
  class Review {
    id : serial «PK»
    productId : integer «FK»
    userId : integer «FK»
    rating : integer
    body : text
    status : review_status
    isVerified : boolean
  }
  class InventoryMovement {
    id : serial «PK»
    productId : integer «FK»
    type : movement_type
    quantity : integer
    note : text
  }
}

package "Services produit" as PS {
  class AdminProductService <<module\nsrc/actions/admin.ts>> {
    saveProductAction(form) : Promise<ActionResult>
    adjustStockAction(form) : Promise<ActionResult>
    saveShelfAction(form)
    saveDuoAction(form)
    saveSubstitutesAction(form)
    savePairsAction(form)
    moderateReviewAction(id, status)
  }
  class CatalogLib <<module\nsrc/lib/catalog.ts>> {
    getProducts(filters)
    getProductBySlug(slug)
    search(query)
  }
  class ShopProductService <<module\nsrc/actions/shop.ts>> {
    submitReviewAction(form)
    toggleWishlistAction(productId)
  }
}

package "Données" as PD {
  class Database <<singleton>> {
    db : DrizzleORM
    pool : Pool
  }
}

' ---------- relations ----------
Brand "1" -- "0..*" Product : brandId
Category "1" -- "0..*" Product : categoryId / universeId
Category "1" -- "0..*" Category : parentId (hiérarchie)
Product "1" -- "0..*" ProductConcern : product_concerns
Concern "1" -- "0..*" ProductConcern : product_concerns
Product "1" -- "0..*" Review : productId
Product "1" -- "0..*" InventoryMovement : productId
AdminProductService ..> Product : CRUD / stock
ShopProductService ..> Review : soumet
AdminProductService ..> Database : requêtes
CatalogLib ..> Database : requêtes

note bottom of product_status
  Prix en millimes (1 DT = 1000 millimes)
  Stock multi-lieux (ezzahra, hammamLif, entrepot)
  Tolerances : sansParfum, grossesse, peauAtopique, yeuxSensibles
end note

' ---------- guidage de mise en page ----------
' grille : Services (haut) / Catalogue (gauche) + Merchandising (droite) / Données (bas)
Brand -[hidden]right-> Category
Category -[hidden]down-> Product
Product -[hidden]down-> ProductConcern
Concern -[hidden]right-> ProductConcern
product_status -[hidden]right-> Concern
Product -[hidden]right-> Review
Review -[hidden]right-> InventoryMovement
Review -[hidden]down-> Shelf
Shelf -[hidden]right-> Duo
Duo -[hidden]right-> ProductSubstitute
ProductSubstitute -[hidden]right-> ProductPair
AdminProductService -[hidden]right-> CatalogLib
CatalogLib -[hidden]right-> ShopProductService
CatalogLib -[hidden]down-> Database
AdminProductService -[hidden]down-> Product

@enduml