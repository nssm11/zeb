@startuml
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Inter
skinparam defaultFontSize 13
skinparam defaultFontColor #2C2A26
skinparam ArrowColor #55504A
skinparam ArrowThickness 1.1
skinparam RoundCorner 8
skinparam classAttributeIconSize 0
hide circle
hide empty fields
hide empty methods
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #A89B85
  BorderThickness 1
  FontColor #2C2A26
  FontStyle plain
  FontSize 13
  StereotypeFontColor #8A7E69
  StereotypeFontStyle plain
  AttributeFontColor #4A443A
  AttributeFontSize 12
  AttributeFontStyle plain
  MethodFontSize 12
  MethodFontColor #4A443A
  MethodFontStyle plain
  SeparatorColor #DCCFBA
}
skinparam enum {
  BackgroundColor #FCFAF5
  BorderColor #C9BCA4
  BorderThickness 1
  FontColor #2C2A26
  FontStyle plain
  EnumFontSize 12
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #A89B85
  BorderThickness 1
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FAF7F1
  BorderColor #DCCFBA
  BorderThickness 1
  FontColor #4A443A
  FontSize 14
  FontStyle plain
}
skinparam note {
  BackgroundColor #FBF8F2
  BorderColor #DCCFBA
  FontColor #6E675C
  FontSize 11
  BorderThickness 1
}
skinparam sequence {
  ArrowColor #4A463F
  ArrowThickness 1.1
  LifeLineBorderColor #C9BDA8
  LifeLineBackgroundColor #FFFFFF
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #A89B85
  ParticipantFontColor #2C2A26
  ParticipantFontSize 13
  ParticipantFontStyle plain
  ActorBackgroundColor #F6F1E8
  ActorBorderColor #A89B85
  ActorFontColor #2C2A26
  ActorFontSize 13
  GroupBackgroundColor #FAF7F1
  GroupBorderColor #D5C7AE
  GroupFontColor #4A443A
  GroupHeaderFontSize 13
  ActivationBackgroundColor #F2EDE3
  ActivationBorderColor #C9BCA4
  DividerBackgroundColor #F1EBDF
  DividerBorderColor #D5C7AE
  DividerFontColor #4A443A
  DividerFontSize 13
  MessageFontColor #3A352E
  ResponseMessageFontColor #7A7263
  BoxPadding 14
  ParticipantPadding 22
}

' ============ CLÉOPÂTRE — Authentification & utilisateurs ============
' Entités (src/db/schema.ts) + modules d'authentification (src/lib/auth.ts, src/actions/auth.ts)

package "Entités de domaine" as PE {
  class User {
    id : serial «PK»
    email : varchar(255) «unique»
    passwordHash : text
    firstName : varchar(80)
    lastName : varchar(80)
    phone : varchar(20)
    role : user_role = customer
    loyaltyPoints : integer = 0
    locale : varchar(10) = fr
    emailVerifiedAt : timestamp
    getFullName() : string
  }
  class Session {
    id : varchar(64) «PK»
    userId : integer «FK»
    expiresAt : timestamp
    userAgent : text
    createdAt : timestamp
  }
  class Address {
    id : serial «PK»
    userId : integer «FK»
    label : varchar(60) = Domicile
    fullName : varchar(160)
    phone : varchar(20)
    line1 / line2 : varchar(200)
    city : varchar(100)
    governorate : varchar(60)
    isDefault : boolean = false
  }
  class PasswordReset {
    tokenHash : varchar(64) «PK»
    userId : integer «FK»
    expiresAt : timestamp
    usedAt : timestamp
  }
  enum user_role {
    customer
    support
    admin
  }
}

package "Services d'authentification" as PS {
  class AuthLib <<module\nsrc/lib/auth.ts>> {
    hashPassword(password) : Promise<string>
    verifyPassword(password, hash) : Promise<boolean>
    createSession(userId, userAgent) : Promise<void>
    destroySession() : Promise<void>
    getCurrentUser() : Promise<SafeUser>
    pruneExpiredSessions() : Promise<void>
  }
  class AuthActions <<module\nsrc/actions/auth.ts>> {
    loginAction(form) : Promise<ActionResult>
    registerAction(form) : Promise<ActionResult>
    logoutAction() : Promise<void>
    saveAddressAction(form) : Promise<ActionResult>
    changePasswordAction(form) : Promise<ActionResult>
    forgotPasswordAction(form) : Promise<ActionResult>
    resetPasswordAction(form) : Promise<ActionResult>
    updateProfileAction(form) : Promise<ActionResult>
  }
  class SafeUser <<type>> {
    id : number
    email : string
    firstName : string
    lastName : string
    role : user_role
    loyaltyPoints : number
  }
}

package "Accès données" as PD {
  class Database <<singleton>> {
    db : DrizzleORM
    pool : Pool
  }
}

' ---------- relations ----------
User "1" -- "0..*" Session : userId
User "1" -- "0..*" PasswordReset : userId
User "1" -- "0..*" Address : userId
User -- user_role : role

AuthActions ..> AuthLib : délègue
AuthActions ..> User : crée / met à jour
AuthActions ..> Address : CRUD
AuthActions ..> PasswordReset : génère / consomme
AuthLib ..> User : lit / vérifie
AuthLib ..> Session : crée / détruit
AuthLib ..> SafeUser : retourne (sans passwordHash)
AuthLib ..> Database : requêtes

note bottom of Session
  Cookie httpOnly «cleo_session»
  — session de 30 jours
end note

note bottom of PasswordReset
  Seul le hash SHA-256 du token
  est stocké (jamais le token brut)
end note

' ---------- guidage de mise en page ----------
User -[hidden]right-> AuthLib
AuthLib -[hidden]down-> Database
Address -[hidden]down-> AuthActions

@enduml
